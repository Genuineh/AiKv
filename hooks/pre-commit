#!/bin/bash
set -euo pipefail

echo "=== pre-commit: $(basename "$PWD") ==="

# Step 1. 分支保护 (硬性): 禁止在基础分支直接提交
bash "$(dirname "$0")/check-branch.sh" || exit 1

# Step 2. 文档链接检查 (硬性): staged .md 相对链接存在性
bash "$(dirname "$0")/check-docs-links.sh" || exit 1

# Step 3. aidb 依赖解析检查 (硬性): 确保 aidb 可被解析
# 方案 B: Cargo.toml 声明 git 依赖, 本地开发可选 ~/.cargo/config.toml patch 覆盖为 ../aidb.
# 两种来源 (git / path) 都合法, 用 cargo tree 确认 aidb 在依赖图中.
if ! cargo tree -i aidb >/dev/null 2>&1; then
  echo "ERROR: aidb dependency not resolvable."
  echo "Ensure Cargo.toml git dependency is reachable, or add local [patch] in ~/.cargo/config.toml."
  exit 1
fi

# Step 4. 代码格式
cargo fmt --check || {
  echo "ERROR: Format check failed. Run 'cargo fmt' to fix."
  exit 1
}

# Step 5. 静态检查 (clippy, 全 feature)
export RUSTFLAGS='-D warnings'
cargo clippy --all-targets --all-features || {
  echo "ERROR: Clippy found issues under --all-features."
  exit 1
}

# Step 6. 安全检查 (audit + deny): 与 CI security.yml 对齐
bash "$(dirname "$0")/check-security.sh" || exit 1

echo "All pre-commit checks passed."
