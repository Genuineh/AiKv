[server]
host = "0.0.0.0"
port = {{ node.port }}

[cluster]
enabled = true
raft_address = "{{ node.name }}:{{ node.raft_port }}"
is_bootstrap = {% if node.id == 1 %}true{% else %}false{% endif %}

[storage]
engine = "aidb"
data_dir = "./data"

[logging]
level = "info"

[tracing]
enabled = true
service_name = "{{ node.name }}"
otlp_endpoint = "http://otel-collector:4317"
sampling_ratio = 1.0
