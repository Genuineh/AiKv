# Multi-stage build: compile aikv with the sibling local AiDb checkout.
FROM rust:bookworm@sha256:e536cf316987faedfe8ae120f83b70c7df0068fdb4fc9efcce55c71a625001d5 AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/aikv

COPY aikv/Cargo.toml aikv/Cargo.lock aikv/rust-toolchain.toml ./
COPY aikv/src ./src
COPY aidb /src/aidb

RUN mkdir -p /usr/local/cargo \
    && printf '%s\n' \
        '[patch."https://github.com/wiqun/AiDb.git"]' \
        'aidb = { path = "/src/aidb" }' \
        > /usr/local/cargo/config.toml \
    && cargo build --release --features cluster,monitoring,compression

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/aikv/target/release/aikv /usr/local/bin/aikv

EXPOSE 6379 16379 26379 9191

ENTRYPOINT ["/usr/local/bin/aikv"]
